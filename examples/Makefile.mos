# Makefile to build the SDL3 examples for MorphOS

CC     = ppc-morphos-gcc-11
CFLAGS = -O3 -noixemul -DHAVE_OPENGL -Wall -I../include -I../include/build_config -I../src
LIBS   = -noixemul -L.. -lSDL3_test -lSDL3 -lGL -lpthread -lm

SRC_FILES := $(wildcard */*/*.c)
DEPS      := $(SRC_FILES:.c=.d)

# Each executable is generated in the same directory as its source file.
# Format: public-target:source-file:output-file
EXAMPLES := \
	renderer-clear:renderer/01-clear/clear.c:renderer/01-clear/renderer-clear \
	renderer-primitives:renderer/02-primitives/primitives.c:renderer/02-primitives/renderer-primitives \
	renderer-lines:renderer/03-lines/lines.c:renderer/03-lines/renderer-lines \
	renderer-points:renderer/04-points/points.c:renderer/04-points/renderer-points \
	renderer-rectangles:renderer/05-rectangles/rectangles.c:renderer/05-rectangles/renderer-rectangles \
	renderer-textures:renderer/06-textures/textures.c:renderer/06-textures/renderer-textures \
	renderer-streaming-textures:renderer/07-streaming-textures/streaming-textures.c:renderer/07-streaming-textures/renderer-streaming-textures \
	renderer-rotating-textures:renderer/08-rotating-textures/rotating-textures.c:renderer/08-rotating-textures/renderer-rotating-textures \
	renderer-scaling-textures:renderer/09-scaling-textures/scaling-textures.c:renderer/09-scaling-textures/renderer-scaling-textures \
	renderer-geometry:renderer/10-geometry/geometry.c:renderer/10-geometry/renderer-geometry \
	renderer-color-mods:renderer/11-color-mods/color-mods.c:renderer/11-color-mods/renderer-color-mods \
	renderer-viewport:renderer/14-viewport/viewport.c:renderer/14-viewport/renderer-viewport \
	renderer-cliprect:renderer/15-cliprect/cliprect.c:renderer/15-cliprect/renderer-cliprect \
	renderer-read-pixels:renderer/17-read-pixels/read-pixels.c:renderer/17-read-pixels/renderer-read-pixels \
	renderer-debug-text:renderer/18-debug-text/debug-text.c:renderer/18-debug-text/renderer-debug-text \
	renderer-affine-textures:renderer/19-affine-textures/affine-textures.c:renderer/19-affine-textures/renderer-affine-textures \
	asyncio-load-bitmaps:asyncio/01-load-bitmaps/load-bitmaps.c:asyncio/01-load-bitmaps/asyncio-load-bitmaps \
	audio-simple-playback:audio/01-simple-playback/simple-playback.c:audio/01-simple-playback/audio-simple-playback \
	audio-simple-playback-callback:audio/02-simple-playback-callback/simple-playback-callback.c:audio/02-simple-playback-callback/audio-simple-playback-callback \
	audio-load-wav:audio/03-load-wav/load-wav.c:audio/03-load-wav/audio-load-wav \
	audio-multiple-streams:audio/04-multiple-streams/multiple-streams.c:audio/04-multiple-streams/audio-multiple-streams \
	audio-planar-data:audio/05-planar-data/planar-data.c:audio/05-planar-data/audio-planar-data \
	demo-snake:demo/01-snake/snake.c:demo/01-snake/demo-snake \
	demo-woodeneye-008:demo/02-woodeneye-008/woodeneye-008.c:demo/02-woodeneye-008/demo-woodeneye-008 \
	demo-infinite-monkeys:demo/03-infinite-monkeys/infinite-monkeys.c:demo/03-infinite-monkeys/demo-infinite-monkeys \
	demo-bytepusher:demo/04-bytepusher/bytepusher.c:demo/04-bytepusher/demo-bytepusher \
	input-joystick-polling:input/01-joystick-polling/joystick-polling.c:input/01-joystick-polling/input-joystick-polling \
	input-joystick-events:input/02-joystick-events/joystick-events.c:input/02-joystick-events/input-joystick-events \
	input-gamepad-polling:input/03-gamepad-polling/gamepad-polling.c:input/03-gamepad-polling/input-gamepad-polling \
	input-gamepad-events:input/04-gamepad-events/gamepad-events.c:input/04-gamepad-events/input-gamepad-events \
	misc-power:misc/01-power/power.c:misc/01-power/misc-power \
	misc-clipboard:misc/02-clipboard/clipboard.c:misc/02-clipboard/misc-clipboard

TARGETS := $(foreach example,$(EXAMPLES),$(word 1,$(subst :, ,$(example))))
OUTPUTS := $(foreach example,$(EXAMPLES),$(word 3,$(subst :, ,$(example))))

.PHONY: all clean $(TARGETS)

all: $(OUTPUTS)

# Keep the old convenient target names, but build the executable in the source directory.
$(foreach example,$(EXAMPLES),$(eval $(word 1,$(subst :, ,$(example))): $(word 3,$(subst :, ,$(example)))))

# Link rules generated from EXAMPLES.
$(foreach example,$(EXAMPLES),$(eval $(word 3,$(subst :, ,$(example))): $(patsubst %.c,%.o,$(word 2,$(subst :, ,$(example)))) ; $$(CC) -o $$@ $$^ $$(LIBS)))

clean:
	rm -f $(OUTPUTS) */*/*.o $(DEPS)

%.d: %.c
	@echo Making dependencies for $<
	@$(CC) -MM -MP -MT $(@:.d=.o) -o $@ $< $(CFLAGS)

%.o: %.c
	@echo Compiling $<
	@$(CC) -o $@ -c $< $(CFLAGS)

# Load .d files
ifneq ($(MAKECMDGOALS),clean)
-include $(DEPS)
endif
